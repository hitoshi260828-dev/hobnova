---
// 写真・イラストを差し込むための領域。
// `image` を渡すと astro:assets で最適化して表示し、渡さない場合は
// 控えめなプレースホルダー（ドットパターン＋アイコン）を表示する。
// 記事に image: ./photo.jpg のようにfrontmatterで画像を追加すれば、
// このコンポーネントが自動的に実画像へ切り替わる。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  aspect?: string;
  iconType?: 'photo' | 'chart';
  class?: string;
}

const { image, alt, aspect = 'aspect-[4/3]', iconType = 'photo', class: className = '' } = Astro.props;
---

<div class:list={['relative overflow-hidden bg-bg-light', aspect, className]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        class="h-full w-full object-cover"
        widths={[320, 640, 960]}
        sizes="(min-width: 1024px) 320px, 50vw"
      />
    ) : (
      <div
        class="flex h-full w-full items-center justify-center"
        style="background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px); background-size: 16px 16px;"
        aria-hidden="true"
      >
        {iconType === 'chart' ? (
          <svg viewBox="0 0 24 24" class="h-8 w-8 text-charcoal/25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="20" x2="21" y2="20" />
            <line x1="6" y1="20" x2="6" y2="12" />
            <line x1="12" y1="20" x2="12" y2="6" />
            <line x1="18" y1="20" x2="18" y2="15" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" class="h-8 w-8 text-charcoal/25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="8.5" cy="9.5" r="1.5" fill="currentColor" stroke="none" />
            <path d="M21 16.5 15.5 11 5 20" />
          </svg>
        )}
      </div>
    )
  }
</div>
