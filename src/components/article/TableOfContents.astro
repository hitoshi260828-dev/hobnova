---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const collapseAfter = 7;
const isLong = items.length > collapseAfter;
---

{
  items.length > 0 && (
    <nav aria-label="目次" class="toc mx-1 overflow-hidden border-y border-border bg-white sm:mx-2 lg:mx-0">
      <div class="flex items-center justify-between px-4 py-4 sm:px-5">
        <p class="m-0 text-base font-bold tracking-wide text-navy">目次</p>
        <span class="text-[10px] font-semibold tracking-[0.18em] text-charcoal/40">CONTENTS</span>
      </div>

      <ol class:list={['toc-list m-0 list-none space-y-0 border-t border-border p-0', isLong && 'toc-collapsed']}>
        {items.map((h, index) => (
          <li
            class:list={[
              'toc-item m-0 p-0',
              h.depth === 3 && 'toc-sub',
              index >= collapseAfter && 'toc-extra',
            ]}
          >
            <a
              href={`#${h.slug}`}
              class:list={[
                'group flex items-start gap-3 px-4 py-2.5 no-underline transition-colors hover:text-accent sm:px-5',
                h.depth === 2 ? 'text-charcoal' : 'pl-4 font-normal text-charcoal/65',
              ]}
            >
              <span class:list={['toc-label block w-full leading-relaxed', h.depth === 2 ? 'text-sm font-semibold' : 'text-xs font-normal']}>{h.text}</span>
            </a>
          </li>
        ))}
      </ol>

      {isLong && (
        <button
          type="button"
          class="toc-toggle flex w-full items-center justify-center gap-2 border-t border-border px-4 py-3 text-xs font-semibold text-charcoal transition-colors hover:text-accent sm:px-5"
          aria-expanded="false"
        >
          <span class="toc-toggle-label">目次をすべて表示</span>
          <span class="toc-toggle-icon text-lg leading-none" aria-hidden="true">＋</span>
        </button>
      )}
    </nav>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.toc').forEach((toc) => {
    const button = toc.querySelector<HTMLButtonElement>('.toc-toggle');
    const list = toc.querySelector<HTMLOListElement>('.toc-list');
    const label = toc.querySelector<HTMLElement>('.toc-toggle-label');
    const icon = toc.querySelector<HTMLElement>('.toc-toggle-icon');
    if (!button || !list || !label || !icon) return;

    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      list.classList.toggle('toc-collapsed', expanded);
      label.textContent = expanded ? '目次をすべて表示' : '閉じる';
      icon.textContent = expanded ? '＋' : '−';
    });
  });
</script>

<style>
  .toc-list.toc-collapsed .toc-extra { display: none; }
  .toc-item.toc-sub { margin-left: 1rem; margin-right: 1rem; border-top: 1px solid var(--color-border); }
  .toc-item.toc-sub + .toc-item.toc-sub { border-top: 0; }
  .toc-item.toc-sub > a { padding-left: 0; padding-right: 0; }
</style>
