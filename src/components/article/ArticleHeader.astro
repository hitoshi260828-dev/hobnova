---
import type { ImageMetadata } from 'astro';
import Badge from '../ui/Badge.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import { formatDate } from '../../lib/format';

interface Props {
  title: string;
  categoryLabelEn?: string;
  categoryLabelJa?: string;
  publishDate: Date;
  updatedDate?: Date;
  image?: ImageMetadata;
}

const { title, categoryLabelEn, categoryLabelJa, publishDate, updatedDate, image } = Astro.props;
---

<header class="mx-auto max-w-3xl px-4 sm:px-6">
  {
    categoryLabelEn && (
      <Badge>
        {categoryLabelEn}
        {categoryLabelJa && <span class="ml-1 text-charcoal/50">{categoryLabelJa}</span>}
      </Badge>
    )
  }

  <h1 class="mt-3 text-2xl font-bold leading-snug text-navy sm:text-3xl">{title}</h1>

  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-charcoal/60">
    <span>公開日: {formatDate(publishDate)}</span>
    {updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
      <span>更新日: {formatDate(updatedDate)}</span>
    )}
  </div>

  <ImagePlaceholder image={image} alt={title} aspect="aspect-video" class="mt-6 rounded-xl border border-border" />
</header>
