---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import { CATEGORIES } from '../../consts';
import { formatDate } from '../../lib/format';

const [articles, dataLab, tools] = await Promise.all([
  getCollection('articles', ({ data }) => !data.draft),
  getCollection('dataLab', ({ data }) => !data.draft),
  getCollection('tools', ({ data }) => !data.draft),
]);

const latest = [
  ...articles.map((entry) => ({
    entry,
    type: 'article' as const,
    href: `${CATEGORIES.find((c) => c.id === entry.data.category)?.href ?? '/'}${entry.id}/`,
    badge: CATEGORIES.find((c) => c.id === entry.data.category)?.labelEn ?? 'ARTICLE',
  })),
  ...dataLab.map((entry) => ({
    entry,
    type: 'dataLab' as const,
    href: `/data-lab/${entry.id}/`,
    badge: 'DATA LAB',
  })),
  ...tools.map((entry) => ({
    entry,
    type: 'tool' as const,
    href: `/tools/${entry.id}/`,
    badge: 'TOOLS',
  })),
]
  .sort((a, b) => b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf())
  .slice(0, 4);
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <SectionHeading labelEn="NEW DISCOVERIES" labelJa="新しい発見" />

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      latest.map(({ entry, href, badge }) => (
        <Card href={href}>
          <ImagePlaceholder
            slot="media"
            image={entry.data.image}
            alt={entry.data.title}
            aspect="aspect-[16/10]"
          />
          <Badge>{badge}</Badge>
          <h3 class="mt-3 line-clamp-2 text-base font-semibold text-navy">{entry.data.title}</h3>
          <p class="mt-2 line-clamp-2 text-sm text-charcoal/70">{entry.data.description}</p>
          <p class="mt-4 text-xs text-charcoal/50">{formatDate(entry.data.publishDate)}</p>
        </Card>
      ))
    }
  </div>
</section>
