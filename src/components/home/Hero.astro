---
import Logo from '../ui/Logo.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import { SITE_TAGLINE } from '../../consts';
import heroCamp from '../../assets/hero/hero-camp.png';
import heroGadget from '../../assets/hero/hero-gadget.png';
import heroData from '../../assets/hero/hero-data.png';
import heroMarketing from '../../assets/hero/hero-marketing.png';

// フォトコラージュ用の画像スロット。
const collage = [
  { image: heroCamp, alt: 'キャンプの様子' },
  { image: heroGadget, alt: 'ガジェットに囲まれたワークスペース' },
  { image: heroData, alt: 'データを分析する様子' },
  { image: heroMarketing, alt: 'デジタルマーケティングのイメージ' },
];
---

<section class="relative overflow-hidden border-b border-border bg-white py-16 sm:py-20 lg:py-24">
  <!-- NOVA要素: 控えめなドットパターン（星を暗示する程度の装飾） -->
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px); background-size: 28px 28px;"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div class="text-center lg:text-left">
      <Logo variant="full" class="mx-auto w-48 sm:w-56 lg:mx-0" />

      <p class="mt-8 text-2xl font-bold text-navy sm:text-3xl">{SITE_TAGLINE}</p>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-charcoal/80 sm:text-base lg:mx-0">
        キャンプ、ガジェット、データ分析、デジタルマーケティング、Webツール。運営者自身が興味を持ったテーマを「試す」「調べる」「分析する」「作る」ことで、新しい発見を届ける個人ラボです。
      </p>
    </div>

    <div class="grid grid-cols-4 gap-2 sm:gap-3">
      {
        collage.map((item, i) => (
          <ImagePlaceholder
            image={item.image}
            alt={item.alt}
            aspect="aspect-[3/4]"
            class:list={[
              'rounded-lg border border-border shadow-sm',
              i % 2 === 1 ? 'translate-y-4 sm:translate-y-6' : '-translate-y-1',
            ]}
          />
        ))
      }
    </div>
  </div>
</section>
