---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import CategoryIcon from '../ui/CategoryIcon.astro';

const entries = await getCollection('tools', ({ data }) => !data.draft);
const latest = entries
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

{
  latest.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading
        labelEn="TOOLS"
        labelJa="ツール"
        description="HOBNOVA独自のシミュレーター・計算ツール。"
        moreHref="/tools/"
      />

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((entry) => (
          <Card href={`/tools/${entry.id}/`}>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-bg-light text-navy">
              <CategoryIcon id="tools" class="h-5 w-5" />
            </div>
            <h3 class="mt-4 line-clamp-2 text-base font-semibold text-navy">{entry.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-charcoal/70">{entry.data.description}</p>
          </Card>
        ))}
      </div>
    </section>
  )
}
