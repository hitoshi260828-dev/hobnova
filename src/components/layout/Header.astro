---
import Logo from '../ui/Logo.astro';
import { HEADER_NAV } from '../../consts';
---

<header class="sticky top-0 z-40 border-b border-border bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-navy" aria-label="HOBNOVA トップページ">
      <Logo variant="mark" class="h-9 w-auto" />
      <span class="text-lg font-bold tracking-tight">HOBNOVA</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="メインナビゲーション">
      {
        HEADER_NAV.map((item) => (
          <a
            href={item.href}
            class="group flex flex-col items-center leading-none text-charcoal transition-colors hover:text-accent"
          >
            <span class="text-[13px] font-semibold tracking-wide">{item.labelEn}</span>
            {item.labelJa && (
              <span class="mt-1 text-[10px] text-charcoal/60 group-hover:text-accent/80">
                {item.labelJa}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        class="rounded-md p-2 text-charcoal hover:bg-bg-light hover:text-accent"
        aria-label="検索（準備中）"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.2" y2="16.2" />
        </svg>
      </button>

      <button
        type="button"
        id="mobile-nav-toggle"
        class="rounded-md p-2 text-charcoal hover:bg-bg-light hover:text-accent md:hidden"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-border bg-white px-4 py-3 md:hidden"
    aria-label="モバイルナビゲーション"
  >
    <ul class="flex flex-col divide-y divide-border">
      {
        HEADER_NAV.map((item) => (
          <li>
            <a href={item.href} class="flex items-baseline justify-between py-3 text-charcoal">
              <span class="text-sm font-semibold tracking-wide">{item.labelEn}</span>
              {item.labelJa && <span class="text-xs text-charcoal/60">{item.labelJa}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');
  });
</script>
