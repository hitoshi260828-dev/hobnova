---
// トピック別ニュース一覧。/news/[...page].astro と同じpaginate()方式を使う
// （記事数が増えてもトピックページが無限に1ページへ並ぶことを避ける）。
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/layout/Breadcrumb.astro';
import NewsList from '../../../../components/news/NewsList.astro';
import { NEWS_PAGE_SIZE, NEWS_TOPICS } from '../../../../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

  return NEWS_TOPICS.flatMap((topic) => {
    const filtered = news.filter((entry) => entry.data.topics.includes(topic.id));
    return paginate(filtered, { params: { topic: topic.id }, pageSize: NEWS_PAGE_SIZE, props: { topic } });
  });
}) satisfies GetStaticPaths;

const { page, topic } = Astro.props;
---

<BaseLayout
  title={`NEWS: ${topic.labelJa}`}
  description={`HOBNOVA NEWSの「${topic.labelJa}（${topic.labelEn}）」トピックに関するニュースまとめ一覧。`}
>
  <Breadcrumb items={[{ label: 'NEWS', href: '/news/' }, { label: topic.labelJa }]} />

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <header>
      <h1 class="flex items-baseline gap-3">
        <span class="text-2xl font-bold tracking-tight text-navy sm:text-3xl">{topic.labelEn}</span>
        <span class="text-sm text-charcoal/70">{topic.labelJa}</span>
      </h1>
    </header>

    <NewsList page={page} />
  </div>
</BaseLayout>
