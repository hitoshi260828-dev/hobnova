---
import { getCollection, render } from 'astro:content';
import DataLabLayout from '../../layouts/DataLabLayout.astro';
import StationOdExplorer from '../../components/datalab/StationOdExplorer.astro';
import StationPassengerExplorer from '../../components/datalab/StationPassengerExplorer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('dataLab', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DataLabLayout entry={entry}>
  <Fragment slot="explorer">
    {entry.data.explorerId === 'station-od-ranking' && (
      <StationOdExplorer dataUrl="/data/shutoken-teiki-od-2015.json" defaultOrigin="新宿" />
    )}
    {entry.data.explorerId === 'station-passenger-trend' && (
      <StationPassengerExplorer dataUrl="/data/s12-station-passengers-2011-2022.json" />
    )}
  </Fragment>
  <Content />
</DataLabLayout>
