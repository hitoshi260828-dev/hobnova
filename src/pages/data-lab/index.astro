---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import Card from '../../components/ui/Card.astro';
import ImagePlaceholder from '../../components/ui/ImagePlaceholder.astro';
import { formatDate } from '../../lib/format';

const entries = (await getCollection('dataLab', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="DATA LAB データラボ"
  description="公開データを収集・分析・可視化する、HOBNOVAのデータラボ一覧です。"
>
  <Breadcrumb items={[{ label: 'DATA LAB' }]} />

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <header>
      <h1 class="flex items-baseline gap-3">
        <span class="text-2xl font-bold tracking-tight text-navy sm:text-3xl">DATA LAB</span>
        <span class="text-sm text-charcoal/70">データラボ</span>
      </h1>
      <p class="mt-2 max-w-2xl text-sm text-charcoal/80">
        公開されているデータを収集・分析・可視化し、グラフやランキングで「データを見る」体験を届けます。
      </p>
    </header>

    {
      entries.length > 0 ? (
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <Card href={`/data-lab/${entry.id}/`}>
              <ImagePlaceholder
                slot="media"
                image={entry.data.image}
                alt={entry.data.title}
                aspect="aspect-[16/10]"
                iconType="chart"
              />
              <h2 class="line-clamp-2 text-base font-semibold text-navy">{entry.data.title}</h2>
              <p class="mt-2 line-clamp-2 text-sm text-charcoal/70">{entry.data.description}</p>
              <p class="mt-4 text-xs text-charcoal/50">更新日: {formatDate(entry.data.publishDate)}</p>
            </Card>
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-charcoal/60">まだデータがありません。近日公開予定です。</p>
      )
    }
  </div>
</BaseLayout>
