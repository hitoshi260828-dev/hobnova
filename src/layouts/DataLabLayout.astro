---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import BreadcrumbJsonLd from '../components/seo/BreadcrumbJsonLd.astro';
import ArticleJsonLd from '../components/seo/ArticleJsonLd.astro';
import ChartBlock from '../components/datalab/ChartBlock.astro';
import RankingTable from '../components/datalab/RankingTable.astro';
import DataTable from '../components/datalab/DataTable.astro';
import { formatDate } from '../lib/format';

interface Props {
  entry: CollectionEntry<'dataLab'>;
}

const { entry } = Astro.props;
const { title, description, publishDate, updatedDate, stats, chart, ranking, table, source, author } = entry.data;
---

<BaseLayout title={title} description={description} type="article">
  <Fragment slot="head-extra">
    <ArticleJsonLd title={title} description={description} publishDate={publishDate} updatedDate={updatedDate} author={author} />
    <BreadcrumbJsonLd items={[{ label: 'DATA LAB', href: '/data-lab/' }, { label: title }]} />
  </Fragment>

  <Breadcrumb items={[{ label: 'DATA LAB', href: '/data-lab/' }, { label: title }]} />

  <header class="bg-navy py-10 text-white sm:py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs font-semibold tracking-widest text-white/60">DATA LAB</p>
      <h1 class="mt-2 text-2xl font-bold sm:text-3xl">{title}</h1>
      <p class="mt-3 text-sm text-white/70">{description}</p>
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-white/50">
        <span>公開日: {formatDate(publishDate)}</span>
        {updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
          <span>更新日: {formatDate(updatedDate)}</span>
        )}
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-3xl space-y-10 px-4 py-10 sm:px-6">
    {
      stats && stats.length > 0 && (
        <section aria-label="主要指標">
          <p class="text-xs font-semibold tracking-wide text-charcoal/60">主要指標</p>
          <dl class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3">
            {stats.map((s) => (
              <div class="rounded-xl border border-border bg-white p-4">
                <dt class="text-[11px] text-charcoal/50">{s.label}</dt>
                <dd class="mt-1 text-lg font-bold text-navy">{s.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <slot name="explorer" />

    {
      chart && (
        <section aria-label="グラフ">
          <p class="text-xs font-semibold tracking-wide text-charcoal/60">グラフ</p>
          <div class="mt-3">
            <ChartBlock id={`chart-${entry.id}`} type={chart.type} labels={chart.labels} series={chart.series} />
          </div>
        </section>
      )
    }

    {
      ranking && ranking.length > 0 && (
        <section aria-label="ランキング">
          <p class="text-xs font-semibold tracking-wide text-charcoal/60">ランキング</p>
          <div class="mt-3">
            <RankingTable items={ranking} />
          </div>
        </section>
      )
    }

    {
      table && (
        <section aria-label="データテーブル">
          <p class="text-xs font-semibold tracking-wide text-charcoal/60">データテーブル</p>
          <div class="mt-3">
            <DataTable headers={table.headers} rows={table.rows} />
          </div>
        </section>
      )
    }

    <section aria-label="分析・考察" class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:text-navy prose-a:text-accent">
      <p class="mb-2 text-xs font-semibold not-italic tracking-wide text-charcoal/60">分析・考察</p>
      <slot />
    </section>

    {source && <p class="border-t border-border pt-6 text-xs text-charcoal/50">データ出典: {source}</p>}
  </div>
</BaseLayout>
