---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import BreadcrumbJsonLd from '../components/seo/BreadcrumbJsonLd.astro';

interface Props {
  entry: CollectionEntry<'tools'>;
}

const { entry } = Astro.props;
const { title, description } = entry.data;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head-extra">
    <BreadcrumbJsonLd items={[{ label: 'TOOLS', href: '/tools/' }, { label: title }]} />
  </Fragment>

  <Breadcrumb items={[{ label: 'TOOLS', href: '/tools/' }, { label: title }]} />

  <div class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <header>
      <p class="text-xs font-semibold tracking-widest text-accent">TOOL</p>
      <h1 class="mt-2 text-2xl font-bold text-navy sm:text-3xl">{title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-charcoal/80">{description}</p>
    </header>

    <div class="mt-8">
      <slot name="tool" />
    </div>

    <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-bold prose-headings:text-navy prose-a:text-accent">
      <slot />
    </div>

    <p class="mt-10 border-t border-border pt-6 text-sm">
      <a href="/tools/" class="text-accent hover:underline">← TOOLS一覧に戻る</a>
    </p>
  </div>
</BaseLayout>
