# scripts/generate-article-images.ts 用の環境変数。
# 実際の値は .env.local（Git管理外）またはGitHub Secretsに設定すること。
# このファイル自体に実際のキーを書かない。

# OpenAI Image API（アイキャッチ画像生成）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Cloudflare Workers AI（本文画像生成）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
