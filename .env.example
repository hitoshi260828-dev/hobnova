# scripts/generate-article-images.ts 用の環境変数。
# 実際の値は .env.local（Git管理外）またはGitHub Secretsに設定すること。
# このファイル自体に実際のキーを書かない。

# OpenAI Image API（アイキャッチ画像生成）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Cloudflare Workers AI（本文画像生成）
# モデル名に応じてリクエスト形式を自動判定する（flux-2系はmultipart/form-data、
# flux-1-schnell等の旧世代はJSON）。詳細は docs/article-image-pipeline.md を参照。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# 任意。拡散ステップ数（flux-2-dev等、steps調整可能なモデルのみ有効）。
# 未設定時は25。範囲外・不正値も25へフォールバックする。steps増加に比例して課金額も増える。
CLOUDFLARE_IMAGE_STEPS=25
# 任意。ガイダンススケール（値が高いほどプロンプトに厳密に従う）。未設定なら送信しない。
CLOUDFLARE_IMAGE_GUIDANCE=
